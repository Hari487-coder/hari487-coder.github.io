---
import { Icon } from 'astro-icon/components';

const path = Astro.url.pathname;

interface Link {
  href: string;
  label: string;
  icon: string;
  match: (p: string) => boolean;
}

/**
 * Three sections: work that is not academic, everything academic, and content.
 *
 * Deliberately nine links. Capture merges the recorder and importer behind one
 * door, Ideas lives inside Studio that produces it, Brainstorm is reached from
 * the notes it reads, and About sits in the footer. Everything stays reachable
 * with fewer front doors.
 */
const groups: { label: string; links: Link[] }[] = [
  {
    label: 'Workspace',
    links: [
      { href: '/', label: 'Home', icon: 'lucide:layout-dashboard', match: (p) => p === '/' },
      { href: '/projects/', label: 'Projects', icon: 'lucide:wrench', match: (p) => p.startsWith('/projects') },
      { href: '/graph/', label: 'Graph', icon: 'lucide:share-2', match: (p) => p.startsWith('/graph') },
    ],
  },
  {
    // Three doors, each opening on a pair of tabbed pages (see lib/subnav.ts).
    label: 'IIT manager',
    links: [
      {
        href: '/iith/',
        label: 'Courses',
        icon: 'lucide:graduation-cap',
        match: (p) =>
          p === '/iith/' || p.startsWith('/iith/courses') || p.startsWith('/iith/timetable'),
      },
      {
        href: '/iith/assignments/',
        label: 'Assignments',
        icon: 'lucide:list-checks',
        match: (p) => p.startsWith('/iith/assignments') || p.startsWith('/iith/inbox'),
      },
      {
        href: '/notes/',
        label: 'Notes',
        icon: 'lucide:notebook-pen',
        match: (p) =>
          p.startsWith('/notes') ||
          p.startsWith('/iith/capture') ||
          p.startsWith('/iith/brainstorm'),
      },
    ],
  },
  {
    label: 'Content creation',
    links: [
      { href: '/studio/', label: 'Studio', icon: 'lucide:clapperboard', match: (p) => p.startsWith('/studio') || p.startsWith('/ideas') },
    ],
  },
];
---

<nav class="sidebar-nav" aria-label="Main">
  {groups.map((group) => (
    <>
      <p class="sidebar-section-label">{group.label}</p>
      {group.links.map(({ href, label, icon, match }) => (
        <a
          href={href}
          class:list={['sidebar-link', { active: match(path) }]}
          aria-current={match(path) ? 'page' : undefined}
        >
          <Icon name={icon} />
          {label}
        </a>
      ))}
    </>
  ))}
</nav>

<div class="sidebar-footer">
  <a
    class:list={['sidebar-link', { active: path.startsWith('/about') }]}
    href="/about/"
    aria-current={path.startsWith('/about') ? 'page' : undefined}
  >
    <Icon name="lucide:user" />
    About
  </a>
  <a class="sidebar-account" href="https://github.com/Hari487-coder">
    <span class="avatar">HP</span>
    <span class="sidebar-account-email">github.com/Hari487-coder</span>
    <Icon name="lucide:github" style="width:14px;height:14px;flex-shrink:0;" />
  </a>
</div>
