---
interface Props {
  title: string;
  href?: string;
  meta: string[];
  due?: string;
  dueHot?: boolean;
  burn?: number;
  state: 'todo' | 'doing' | 'done' | 'overdue';
  note?: string;
  tick?: boolean;
}

const { title, href, meta, due, dueHot = false, burn, state, note, tick = false } = Astro.props;
const showFuse = typeof burn === 'number' && state !== 'done';
---

<div class:list={['lrow', { done: state === 'done', tick }]} style={showFuse ? `--burn: ${burn}` : undefined}>
  <div class="gutter">
    {due && <span class={dueHot ? 'due-hot' : undefined}>{due}</span>}
    {meta.map((m) => <span>{m}</span>)}
  </div>
  <div class="entry">
    <div class="title">
      {href ? <a href={href}>{title}</a> : title}
    </div>
    {note && <div class="note">{note}</div>}
    {showFuse && <div class="fuse" aria-hidden="true"></div>}
  </div>
</div>
