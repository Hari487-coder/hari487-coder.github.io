---
import { Icon } from 'astro-icon/components';
---

<button class="theme-toggle" id="theme-toggle" aria-label="Theme: auto">
  <span class="t-auto" aria-hidden="true"><Icon name="ph:circle-half" /></span>
  <span class="t-light" aria-hidden="true"><Icon name="ph:sun" /></span>
  <span class="t-dark" aria-hidden="true"><Icon name="ph:moon" /></span>
  <span class="t-label" data-auto="auto" data-light="light" data-dark="dark">auto</span>
</button>

<style>
  .theme-toggle span { display: none; align-items: center; }
  .theme-toggle .t-label { display: inline; }
  html:not([data-theme]) .theme-toggle .t-auto { display: inline-flex; }
  html[data-theme='light'] .theme-toggle .t-light { display: inline-flex; }
  html[data-theme='dark'] .theme-toggle .t-dark { display: inline-flex; }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    function current() {
      return document.documentElement.getAttribute('data-theme') || 'auto';
    }
    function label() {
      var l = btn.querySelector('.t-label');
      var c = current();
      if (l) l.textContent = c;
      btn.setAttribute('aria-label', 'Theme: ' + c);
    }
    btn.addEventListener('click', function () {
      var next = { auto: 'light', light: 'dark', dark: 'auto' }[current()];
      try {
        if (next === 'auto') {
          localStorage.removeItem('theme');
          document.documentElement.removeAttribute('data-theme');
        } else {
          localStorage.setItem('theme', next);
          document.documentElement.setAttribute('data-theme', next);
        }
      } catch (e) {}
      label();
    });
    label();
  })();
</script>
