---
import Base from '../layouts/Base.astro';
import { stamp, todayIST } from '../lib/dates';

const today = todayIST();
---

<Base title="About" description="Who keeps this ledger: Hari Prathap, IITH M.Tech student and customer success engineer.">
  <div class="ledger">
    <p class="log-stamp">{stamp(today)} · ABOUT</p>
    <h1 class="page-title">About</h1>

    <div class="lrow">
      <div class="gutter facts">
        <span>Hyderabad, IN</span>
        <span><a href="https://github.com/Hari487-coder">github</a></span>
      </div>
      <div class="entry">
        <div class="note">student, engineer, keeper of this ledger</div>
      </div>
    </div>

    <div class="prose">
      <p>
        I am doing an M.Tech in Techno-Entrepreneurship at IIT Hyderabad and working
        customer success engineering at an AI voice startup at the same time. Days are
        support traces and shipped fixes; evenings are coursework; the gaps in between
        are where the projects happen.
      </p>
      <p>
        I build with Claude Code, end to end: records platforms, compliance bridges,
        analytics warehouses, small tools that fix one annoying thing properly. Most of
        what I learn comes from shipping something real and watching where it breaks.
      </p>
      <p>
        This site is the ledger I actually keep. Assignments, courses, and builds go in
        as entries; the software just turns the pages. If something here is useful to
        you, take it.
      </p>
    </div>
  </div>
</Base>
