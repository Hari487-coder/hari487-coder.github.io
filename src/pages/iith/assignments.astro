---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import SubTabs from '../../components/SubTabs.astro';
import { WORK_TABS } from '../../lib/subnav';
import AssignmentRow from '../../components/AssignmentRow.astro';
import { daysLeft, fmt, isOverdue, todayIST } from '../../lib/dates';

const today = todayIST();
const courses = await getCollection('courses');
const courseById = new Map(courses.map((c) => [c.id, c]));

const assignments = await getCollection('assignments');

const doing = assignments
  .filter((a) => a.data.status === 'doing')
  .sort((a, b) => a.data.due.getTime() - b.data.due.getTime());
const todo = assignments
  .filter((a) => a.data.status === 'todo')
  .sort((a, b) => a.data.due.getTime() - b.data.due.getTime());
const done = assignments
  .filter((a) => a.data.status === 'done')
  .sort((a, b) => b.data.due.getTime() - a.data.due.getTime());

function rowProps(a: (typeof assignments)[number]) {
  const course = courseById.get(a.data.course.id);
  const isDone = a.data.status === 'done';
  const overdue = !isDone && isOverdue(a.data.due, today);
  return {
    title: a.data.title,
    href: course ? `/iith/courses/${course.id}/` : undefined,
    sub: course ? `${course.data.code} · ${course.data.name}` : a.data.course.id,
    due: fmt(a.data.due),
    dueHot: overdue || (!isDone && daysLeft(a.data.due, today) <= 2),
    state: (isDone ? 'done' : overdue ? 'overdue' : a.data.status) as
      | 'todo'
      | 'doing'
      | 'done'
      | 'overdue',
  };
}

const groups = [
  { title: 'In progress', items: doing, empty: 'Nothing in progress right now.' },
  { title: 'To do', items: todo, empty: 'The queue is empty.' },
  { title: 'Done', items: done, empty: 'Nothing cleared yet.' },
];
---

<Base title="Assignments" description="Every assignment across all IITH courses, by status.">
  <div class="page-head">
    <div class="page-head-text">
      <p class="eyebrow">IIT Hyderabad</p>
      <h1>Assignments</h1>
      <p class="subtitle">Everything owed and everything cleared, across all courses.</p>
    </div>
  </div>

  <SubTabs tabs={WORK_TABS} active="assignments" />

  {groups.map(({ title, items, empty }) => (
    <section class="section">
      <div class="section-head">
        <h2>{title}</h2>
        <span class="meta">{items.length}</span>
      </div>
      <div class="card">
        {items.length === 0 ? (
          <div class="empty-state" style="padding: 28px 24px;">
            <span class="empty-icon"><Icon name="lucide:inbox" /></span>
            <p>{empty}</p>
          </div>
        ) : (
          <ul class="row-list" style="margin-top: 0;">
            {items.map((a) => <AssignmentRow {...rowProps(a)} />)}
          </ul>
        )}
      </div>
    </section>
  ))}
</Base>
