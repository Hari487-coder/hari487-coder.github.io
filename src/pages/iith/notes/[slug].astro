---
import { getCollection, getEntry, render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '../../../layouts/Base.astro';
import { fmt } from '../../../lib/dates';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const course = await getEntry('courses', note.data.course.id);
---

<Base title={note.data.title} description={`Lecture notes: ${note.data.title}`}>
  <div class="page-head">
    <div class="page-head-text">
      <p class="eyebrow">{course?.data.code ?? note.data.course.id} · {fmt(note.data.date)}</p>
      <h1>{note.data.title}</h1>
      {course && <p class="subtitle">{course.data.name}</p>}
    </div>
  </div>

  <div class="card">
    <div class="prose">
      <Content />
    </div>
  </div>

  {course && (
    <p style="margin: 16px 0 0;">
      <a class="btn-secondary" href={`/iith/courses/${course.id}/`}>
        <Icon name="lucide:arrow-left" /> Back to {course.data.code}
      </a>
    </p>
  )}
</Base>
