---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import SubTabs from '../../components/SubTabs.astro';
import { COURSE_TABS } from '../../lib/subnav';
import { DAYS, TERM, meetingsFor, rangeLabel, to12h } from '../../lib/slots';
import { credits as fmtCredits } from '../../lib/format';

const courses = (await getCollection('courses'))
  .filter((c) => c.data.status === 'ongoing')
  .sort((a, b) => a.data.code.localeCompare(b.data.code));

interface Entry {
  code: string;
  name: string;
  room?: string;
  id: string;
  start: string;
  end: string;
  provisional: boolean;
}

const scheduled = courses
  .map((c) => ({ course: c, meetings: meetingsFor(c.data.slot, c.data.meetings) }))
  .filter((x) => x.meetings.length > 0);

/** Rows come from the times actually in use, not a fixed period list: an 8am
    two-hour block exists on this timetable and no published slot has one. */
const startTimes = [...new Set(scheduled.flatMap((x) => x.meetings.map((m) => m.start)))].sort();

const cells: Record<string, Entry[]> = {};
for (const { course, meetings } of scheduled) {
  for (const m of meetings) {
    (cells[`${m.day}-${m.start}`] ??= []).push({
      code: course.data.code,
      name: course.data.name,
      room: course.data.room,
      id: course.id,
      start: m.start,
      end: m.end,
      provisional: Boolean(course.data.timingNote),
    });
  }
}

const untimetabled = courses.filter(
  (c) => meetingsFor(c.data.slot, c.data.meetings).length === 0,
);

const timingNotes = courses
  .filter((c) => c.data.timingNote)
  .map((c) => ({ code: c.data.code, id: c.id, note: c.data.timingNote as string }));

const weeklySessions = Object.values(cells).flat().length;

/** Serialized for the calendar export. */
const exportRows = scheduled.flatMap(({ course, meetings }) =>
  meetings.map((m) => ({
    code: course.data.code,
    title: course.data.name,
    room: course.data.room ?? '',
    instructor: course.data.instructor ?? '',
    slot: course.data.slot ?? '',
    day: m.day,
    start: m.start,
    end: m.end,
  })),
);
---

<Base
  title="Timetable"
  description="The weekly IITH timetable: every registered course in its slot, with rooms."
>
  <div class="page-head">
    <div class="page-head-text">
      <p class="eyebrow">Jul to Nov 2026 · {weeklySessions} sessions a week</p>
      <h1>Timetable</h1>
      <p class="subtitle">
        Built from the IITH slot grid, so each course sits where its slot letter puts it.
      </p>
    </div>
    <button class="btn-secondary" id="export-ics">
      <Icon name="lucide:calendar-plus" /> Add to calendar
    </button>
  </div>

  <SubTabs tabs={COURSE_TABS} active="timetable" />

  <div class="card tt-card">
    <div class="tt-scroll">
      <table class="tt">
        <thead>
          <tr>
            <th class="tt-time"></th>
            {DAYS.map((d) => <th>{d}</th>)}
          </tr>
        </thead>
        <tbody>
          {startTimes.map((p) => (
            <tr>
              <th class="tt-time">{to12h(p)}</th>
              {DAYS.map((_d, di) => {
                const here = cells[`${di}-${p}`] ?? [];
                return (
                  <td class:list={[{ filled: here.length > 0, clash: here.length > 1 }]}>
                    {here.map((c) => (
                      <a class="tt-item" href={`/iith/courses/${c.id}/`}>
                        <span class="tt-code mono">
                          {c.code}
                          {c.provisional && <span class="tt-flag" title="Timings announced by the instructor, see note below">*</span>}
                        </span>
                        <span class="tt-name">{c.name}</span>
                        <span class="tt-when mono">{rangeLabel(c.start, c.end)}</span>
                        {c.room && <span class="tt-room mono">{c.room}</span>}
                      </a>
                    ))}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  {timingNotes.length > 0 && (
    <div class="card note-card">
      {timingNotes.map((n) => (
        <p class="note-line">
          <a class="mono" href={`/iith/courses/${n.id}/`}>{n.code}</a> {n.note}
        </p>
      ))}
    </div>
  )}

  {untimetabled.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2>Not on the grid</h2>
        <span class="meta">{untimetabled.length}</span>
      </div>
      <div class="card">
        <ul class="row-list" style="margin-top: 0;">
          {untimetabled.map((c) => (
            <li>
              <div class="row-main">
                <a class="row-title" href={`/iith/courses/${c.id}/`}>{c.data.name}</a>
                <div class="row-sub">
                  {c.data.code} · {fmtCredits(c.data.credits)} · no published timings
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Base>

<style>
  .tt-card {
    padding: 14px;
  }
  .tt-scroll {
    overflow-x: auto;
  }
  .tt {
    width: 100%;
    border-collapse: separate;
    border-spacing: 6px;
    min-width: 720px;
  }
  .tt thead th {
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    padding-bottom: 2px;
    text-align: left;
  }
  .tt-time {
    width: 82px;
    text-align: left;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--text-secondary);
    vertical-align: top;
    padding-top: 10px;
    white-space: nowrap;
  }
  .tt td {
    background: var(--surface-sunken);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    height: 62px;
    vertical-align: top;
    padding: 0;
  }
  .tt td.filled {
    background: var(--accent-tint);
    border-color: var(--accent-tint-border);
  }
  .tt td.clash {
    background: var(--critical-tint);
    border-color: var(--critical-tint-border);
  }
  .tt-item {
    display: block;
    padding: 9px 11px;
    text-decoration: none;
    color: inherit;
  }
  .tt-code {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: var(--accent-strong);
  }
  .tt-name {
    display: block;
    font-size: 12px;
    color: var(--text-secondary);
    margin-top: 1px;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .tt-when {
    display: block;
    font-size: 11px;
    color: var(--accent-strong);
    margin-top: 3px;
  }
  .tt-room {
    display: block;
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 2px;
  }
  .tt-flag {
    color: var(--warning);
    font-weight: 700;
    margin-left: 2px;
  }
  .note-card {
    margin-top: 16px;
    background: var(--warning-tint);
    border-color: var(--warning-tint-border);
  }
  .note-line {
    margin: 0 0 8px;
    font-size: 13.5px;
    color: var(--warning);
    line-height: 1.55;
  }
  .note-line:last-child {
    margin-bottom: 0;
  }
  .note-line a {
    color: inherit;
    font-weight: 700;
    text-decoration: underline;
  }
  .tt-item:hover .tt-code {
    text-decoration: underline;
  }
</style>

<script define:vars={{ exportRows, TERM, DAYS }}>
  window.__ttExport = { rows: exportRows, term: TERM, days: DAYS };
</script>

<script>
  const data = (window as any).__ttExport as {
    rows: {
      code: string;
      title: string;
      room: string;
      instructor: string;
      slot: string;
      day: number;
      start: string;
      end: string;
    }[];
    term: { firstDate: string[]; end: string };
  };

  const button = document.getElementById('export-ics');

  const hhmmss = (t: string) => `${t.replace(':', '')}00`;
  const escape = (s: string) => s.replace(/([,;\\])/g, '\\$1').replace(/\n/g, '\\n');

  /** RFC 5545 caps lines at 75 octets; continuation lines start with a space. */
  function fold(line: string): string {
    if (line.length <= 73) return line;
    const parts = [line.slice(0, 73)];
    let rest = line.slice(73);
    while (rest.length > 72) {
      parts.push(` ${rest.slice(0, 72)}`);
      rest = rest.slice(72);
    }
    if (rest) parts.push(` ${rest}`);
    return parts.join('\r\n');
  }

  button?.addEventListener('click', () => {
    const stamp = new Date().toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
    const lines = [
      'BEGIN:VCALENDAR',
      'VERSION:2.0',
      'PRODID:-//hari life hub//timetable//EN',
      'CALSCALE:GREGORIAN',
      'BEGIN:VTIMEZONE',
      'TZID:Asia/Kolkata',
      'BEGIN:STANDARD',
      'DTSTART:19700101T000000',
      'TZOFFSETFROM:+0530',
      'TZOFFSETTO:+0530',
      'TZNAME:IST',
      'END:STANDARD',
      'END:VTIMEZONE',
    ];

    for (const r of data.rows) {
      const date = data.term.firstDate[r.day];
      lines.push(
        'BEGIN:VEVENT',
        `UID:${r.code}-${r.day}-${r.start.replace(':', '')}-lifehub@local`,
        `DTSTAMP:${stamp}`,
        `DTSTART;TZID=Asia/Kolkata:${date}T${hhmmss(r.start)}`,
        `DTEND;TZID=Asia/Kolkata:${date}T${hhmmss(r.end)}`,
        `RRULE:FREQ=WEEKLY;UNTIL=${data.term.end}Z`,
        fold(`SUMMARY:${escape(`${r.code} ${r.title}`)}`),
      );
      if (r.room) lines.push(fold(`LOCATION:${escape(r.room)}`));
      lines.push(
        fold(
          `DESCRIPTION:${escape(
            `Slot ${r.slot}${r.instructor ? ` · ${r.instructor}` : ''}`,
          )}`,
        ),
        'END:VEVENT',
      );
    }

    lines.push('END:VCALENDAR');

    const blob = new Blob([lines.join('\r\n')], { type: 'text/calendar' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'iith-timetable.ics';
    a.click();
    URL.revokeObjectURL(a.href);
  });
</script>
