---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import AssignmentRow from '../../../components/AssignmentRow.astro';
import Backlinks from '../../../components/Backlinks.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import { daysLeft, fmt, isOverdue, todayIST } from '../../../lib/dates';
import { credits } from '../../../lib/format';

export async function getStaticPaths() {
  const courses = await getCollection('courses');
  return courses.map((course) => ({ params: { slug: course.id }, props: { course } }));
}

const { course } = Astro.props;
const { Content } = await render(course);
const today = todayIST();

const assignments = (await getCollection('assignments'))
  .filter((a) => a.data.course.id === course.id)
  .sort((a, b) => a.data.due.getTime() - b.data.due.getTime());

const notes = (await getCollection('notes'))
  .filter((n) => n.data.course?.id === course.id)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const badge = course.data.status === 'ongoing'
  ? { tone: 'good', label: 'In session' }
  : course.data.status === 'done'
    ? { tone: 'neutral', label: 'Completed' }
    : { tone: 'accent', label: 'Planned' };
---

<Base
  title={course.data.code}
  description={`${course.data.code} ${course.data.name}: notes and assignments.`}
>
  <div class="page-head">
    <div class="page-head-text">
      <p class="eyebrow">{course.data.code}{course.data.slot ? ` · Slot ${course.data.slot}` : ''}</p>
      <h1>{course.data.name}</h1>
      <p class="subtitle">
        Semester {course.data.semester} · {credits(course.data.credits)}
        {course.data.instructor ? ` · ${course.data.instructor}` : ''}
      </p>
    </div>
    <StatusBadge tone={badge.tone as any} label={badge.label} />
  </div>

  <div class="card">
    <div class="prose">
      <Content />
    </div>
  </div>

  <Backlinks kind="course" id={course.id} />

  {notes.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2>Lecture notes</h2>
        <span class="meta">{notes.length}</span>
      </div>
      <div class="card">
        <ul class="row-list" style="margin-top: 0;">
          {notes.map((n) => (
            <li>
              <div class="row-main">
                <a class="row-title" href={`/notes/${n.id}/`}>{n.data.title}</a>
              </div>
              <div class="row-side">
                <span class="row-due">{fmt(n.data.date)}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section">
    <div class="section-head">
      <h2>Assignments</h2>
    </div>
    <div class="card">
      {assignments.length === 0 ? (
        <p class="meta" style="margin: 0;">Nothing logged for this course yet.</p>
      ) : (
        <ul class="row-list" style="margin-top: 0;">
          {assignments.map((a) => {
            const isDone = a.data.status === 'done';
            const overdue = !isDone && isOverdue(a.data.due, today);
            return (
              <AssignmentRow
                title={a.data.title}
                href={a.data.link}
                sub={isDone ? 'Cleared' : 'Open'}
                due={fmt(a.data.due)}
                dueHot={overdue || (!isDone && daysLeft(a.data.due, today) <= 2)}
                state={isDone ? 'done' : overdue ? 'overdue' : a.data.status}
              />
            );
          })}
        </ul>
      )}
    </div>
  </section>
</Base>
