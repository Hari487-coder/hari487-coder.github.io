    display: none;
  }
  .settings-body {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 46rem;
  }
  .check-field {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    cursor: pointer;
    font-size: 14px;
  }
  .check-field input {
    margin-top: 2px;
    width: 16px;
    height: 16px;
    flex: none;
    accent-color: var(--accent);
  }
  .check-field .meta {
    margin-top: 3px;
    line-height: 1.5;
  }
  #actions-card {
    margin-top: 16px;
  }
</style>

<script define:vars={{ notesByCourse }}>
  window.__pastNotes = notesByCourse;
</script>

<script>
  import { marked } from 'marked';
  import DOMPurify from 'dompurify';
  import { createRecognizer, isSupported } from '../../../lib/live/recognizer';
  import {
    clearSession,
    createSession,
    elapsed,
    loadSession,
    persistSession,
    persistSessionNow,
    transcriptText,
    wordCount,
    type LiveSession,
  } from '../../../lib/live/session';
  import { MIN_DELTA_CHARS, updateNotes } from '../../../lib/live/notesEngine';
  import { downloadMd, saveToRepo } from '../../../lib/live/saver';
  import {
    appendChunk,
    audioFilename,
    clearRecording,
    createAudioRecorder,
    formatBytes,
    readRecording,
    recordedBytes,
  } from '../../../lib/live/audio';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) =>
    document.getElementById(id) as T;

  const els = {
    category: $<HTMLSelectElement>('category'),
    courseField: $('course-field'),
    noTokenWarning: $('no-token-warning'),
    course: $<HTMLSelectElement>('course'),
    topic: $<HTMLInputElement>('topic'),
    start: $<HTMLButtonElement>('start'),
    stop: $<HTMLButtonElement>('stop'),
    statusBadge: $('status-badge'),
    statusText: $('status-text'),
    timer: $('timer'),
    wordcount: $('wordcount'),
    transcriptEmpty: $('transcript-empty'),
    transcriptFinal: $('transcript-final'),
    transcriptInterim: $('transcript-interim'),
    transcriptPane: $('transcript'),
    notes: $('notes'),
    notesEmpty: $('notes-empty'),
    notesStatus: $('notes-status'),
    actionsCard: $('actions-card'),
    save: $<HTMLButtonElement>('save'),
    download: $<HTMLButtonElement>('download'),
    copy: $<HTMLButtonElement>('copy'),
    discard: $<HTMLButtonElement>('discard'),
    saveStatus: $('save-status'),
    saveSuccess: $('save-success'),
    saveSiteLink: $<HTMLAnchorElement>('save-site-link'),
    saveRepoLink: $<HTMLAnchorElement>('save-repo-link'),
    saveError: $('save-error'),
    keyAnthropic: $<HTMLInputElement>('key-anthropic'),
    keyGithub: $<HTMLInputElement>('key-github'),
    saveKeys: $<HTMLButtonElement>('save-keys'),
    testKey: $<HTMLButtonElement>('test-key'),
    keysStatus: $('keys-status'),
    optRecordAudio: $<HTMLInputElement>('opt-record-audio'),
    unsupported: $('unsupported'),
    restoreBanner: $('restore-banner'),
    restoreInfo: $('restore-info'),
    restoreOpen: $<HTMLButtonElement>('restore-open'),
    restoreDiscard: $<HTMLButtonElement>('restore-discard'),
    audioStatus: $('audio-status'),
    downloadAudio: $<HTMLButtonElement>('download-audio'),
    downloadAudioLabel: $('download-audio-label'),
    audioHint: $('audio-hint'),
  };

  let session: LiveSession | null = null;
  let recording = false;
  let timerHandle: number | undefined;
  let tickHandle: number | undefined;
  let aiBusy = false;
  let wakeLock: any = null;

  // ---------- section + save-readiness ----------
  const isCourseCategory = () => els.category.value === 'iith';

  function refreshCategory() {
    els.courseField.hidden = !isCourseCategory();
    const section = document.getElementById('past-notes-section') as HTMLElement;
    section.hidden = !isCourseCategory();
  }

  /** Warn BEFORE recording, not after: a missing token used to surface only at
      the end, once the lecture was already over. */
  function refreshSaveReadiness() {
    els.noTokenWarning.hidden = Boolean(localStorage.getItem('live.githubToken'));
  }

  els.category.addEventListener('change', refreshCategory);
  refreshCategory();
  refreshSaveReadiness();

  // ---------- past notes for the selected course ----------
  const pastNotes = (window as any).__pastNotes as Record<
    string,
    { title: string; href: string; date: string }[]
  >;

  function renderPastNotes() {
    const list = pastNotes[els.course.value] ?? [];
    const listEl = document.getElementById('past-list') as HTMLUListElement;
    const emptyEl = document.getElementById('past-empty') as HTMLElement;
    const countEl = document.getElementById('past-count') as HTMLElement;

    countEl.textContent = list.length ? String(list.length) : '';
    emptyEl.hidden = list.length > 0;
    listEl.hidden = list.length === 0;
    listEl.innerHTML = '';

    for (const note of list) {
      const li = document.createElement('li');
      const main = document.createElement('div');
      main.className = 'row-main';
      const link = document.createElement('a');
      link.className = 'row-title';
      link.href = note.href;
      link.textContent = note.title;
      main.append(link);

      const side = document.createElement('div');
      side.className = 'row-side';
      const date = document.createElement('span');
      date.className = 'row-due';
      date.textContent = note.date;
      side.append(date);

      li.append(main, side);
      listEl.append(li);
    }
  }

  els.course.addEventListener('change', renderPastNotes);
  renderPastNotes();

  // ---------- keys ----------
  els.optRecordAudio.checked = audioBackupEnabled();
  els.optRecordAudio.addEventListener('change', () => {
    try {
      localStorage.setItem(AUDIO_OPT_KEY, els.optRecordAudio.checked ? '1' : '0');
    } catch {
      // Private mode: the toggle just will not persist.
    }
    els.keysStatus.textContent = els.optRecordAudio.checked
      ? 'audio backup on; do a short test that words still appear'
      : 'audio backup off';
  });

  els.keyAnthropic.value = localStorage.getItem('live.anthropicKey') ?? '';
  els.keyGithub.value = localStorage.getItem('live.githubToken') ?? '';
  els.saveKeys.addEventListener('click', () => {
    localStorage.setItem('live.anthropicKey', els.keyAnthropic.value.trim());
    localStorage.setItem('live.githubToken', els.keyGithub.value.trim());
    els.keysStatus.textContent = 'Saved in this browser.';
    refreshSaveReadiness();
  });

  // Prove the key works before class, not during it.
  els.testKey.addEventListener('click', async () => {
    const key = els.keyAnthropic.value.trim() || localStorage.getItem('live.anthropicKey');
    if (!key) {
      els.keysStatus.textContent = 'Paste an Anthropic API key first.';
      return;
    }
    els.testKey.disabled = true;
    els.keysStatus.textContent = 'Testing...';
    try {
      const res = await fetch('https://api.anthropic.com/v1/messages', {
        method: 'POST',
        headers: {
          'content-type': 'application/json',
          'x-api-key': key,
          'anthropic-version': '2023-06-01',
          'anthropic-dangerous-direct-browser-access': 'true',
        },
        body: JSON.stringify({
          model: 'claude-haiku-4-5',
          max_tokens: 1,
          messages: [{ role: 'user', content: 'hi' }],
        }),
      });
      if (res.ok) {
        els.keysStatus.textContent = 'Key works. Live notes will generate.';
      } else if (res.status === 401) {
        els.keysStatus.textContent = 'Key rejected by Anthropic (401). Check the key.';
      } else if (res.status === 429) {
        els.keysStatus.textContent = 'Key is valid but rate limited right now (429).';
      } else {
        const detail = await res.text().catch(() => '');
        els.keysStatus.textContent = `Anthropic returned ${res.status}. ${detail.slice(0, 120)}`;
      }
    } catch (err) {
      els.keysStatus.textContent = `Could not reach Anthropic: ${err instanceof Error ? err.message : err}`;
    } finally {
      els.testKey.disabled = false;
    }
  });

  // ---------- rendering ----------
  function setBadge(text: string, cls: '' | 'rec' | 'ok') {
    els.statusText.textContent = text;
    els.statusBadge.classList.remove('rec', 'ok');
    if (cls) els.statusBadge.classList.add(cls);
  }

  function renderTranscript() {
    if (!session) return;
    els.transcriptEmpty.hidden = session.finals.length > 0;
    els.transcriptFinal.textContent = transcriptText(session) + ' ';
    els.wordcount.textContent = `${wordCount(session)} words`;
    els.transcriptPane.scrollTop = els.transcriptPane.scrollHeight;
  }

  async function renderNotes() {
    if (!session) return;
    if (!session.notes) return;
    els.notesEmpty.hidden = true;
    const html = DOMPurify.sanitize(await marked.parse(session.notes));
    els.notes.innerHTML = html;
  }

  // ---------- AI loop ----------
  async function aiTick(final = false) {
    if (!session || aiBusy) return;
    const key = localStorage.getItem('live.anthropicKey');
    if (!key) {
      els.notesStatus.textContent = 'no API key: transcript only';
      return;
    }
    const deltaLen = transcriptText(session).length - session.cursor;
    if (deltaLen < (final ? 1 : MIN_DELTA_CHARS)) return;

    aiBusy = true;
    els.notesStatus.textContent = final ? 'final pass...' : 'updating notes...';
    try {
      const result = await updateNotes({ apiKey: key, session });
      session.notes = result.notes;
      session.cursor = result.cursor;
      persistSessionNow(session);
      await renderNotes();
      els.notesStatus.textContent = `updated ${new Date().toLocaleTimeString()}`;
    } catch (err) {
      els.notesStatus.textContent = 'AI call failed, will retry';
      console.warn('notes update failed', err);
    } finally {
      aiBusy = false;
    }
  }

  // ---------- wake lock ----------
  async function acquireWakeLock() {
    try {
      wakeLock = await (navigator as any).wakeLock?.request('screen');
    } catch {
      // Not fatal; the phone may still sleep.
    }
  }
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible' && recording) acquireWakeLock();
  });

  // ---------- audio backup ----------
  const AUDIO_OPT_KEY = 'live.recordAudio';

  function audioBackupEnabled(): boolean {
    try {
      return localStorage.getItem(AUDIO_OPT_KEY) === '1';
    } catch {
      return false;
    }
  }

  // Runs beside the recogniser so a poor live transcript costs an inconvenience
  // rather than the class. Never blocks or stops the lecture on failure.
  const audioRecorder = createAudioRecorder({
    onState(state, detail) {
      if (state === 'recording') els.audioStatus.textContent = 'audio 0 KB';
      else if (state === 'unavailable') els.audioStatus.textContent = detail ?? 'audio off';
      else els.audioStatus.textContent = '';
    },
    onProgress(bytes) {
      els.audioStatus.textContent = `audio ${formatBytes(bytes)}`;
    },
  });

  // ---------- recognizer ----------
  const recognizer = createRecognizer({
    onFinal(text) {
      if (!session) return;
      session.finals.push(text);
      persistSession(session);
      renderTranscript();
    },
    onInterim(text) {
      els.transcriptInterim.textContent = text;
    },
    onState(state) {
      if (state === 'unsupported') {
        els.unsupported.hidden = false;
        els.start.disabled = true;
        return;
      }
      if (state === 'denied') {
        setBadge('mic blocked', '');
        els.notesStatus.textContent = 'allow microphone access and restart';
        return;
      }
      if (!recording) return;
      if (state === 'listening') setBadge('listening', 'rec');
      if (state === 'restarting') setBadge('restarting', '');
    },
  });

  // ---------- lifecycle ----------
  function startTimers() {
    timerHandle = window.setInterval(() => {
      if (session) els.timer.textContent = elapsed(session);
    }, 1000);
    tickHandle = window.setInterval(() => void aiTick(false), 90_000);
  }

  function stopTimers() {
    window.clearInterval(timerHandle);
    window.clearInterval(tickHandle);
  }

  function begin(existing?: LiveSession) {
    const option = els.course.selectedOptions[0];
    const courseCategory = isCourseCategory();
    session =
      existing ??
      createSession({
        category: els.category.value,
        courseId: courseCategory ? els.course.value : '',
        courseCode: courseCategory ? (option?.dataset.code ?? els.course.value) : '',
        courseName: courseCategory ? (option?.dataset.name ?? '') : '',
        topic: els.topic.value.trim(),
      });
    persistSessionNow(session);
    recording = true;
    els.start.hidden = true;
    els.stop.hidden = false;
    els.actionsCard.hidden = true;
    els.restoreBanner.hidden = true;
    els.course.disabled = true;
    els.topic.disabled = true;
    els.category.disabled = true;
    renderTranscript();
    void renderNotes();
    recognizer.start();
    // Opt in only. A second microphone stream can stop Chrome's speech capture
    // dead, and the transcript is the primary function: the backup must never be
    // able to break it. Not awaited either, so a slow or failing recorder cannot
    // hold up the start of a lecture.
    //
    // The chunk store holds one recording. Clearing first is what stops a second
    // lecture being concatenated onto the first into an unplayable file.
    if (audioBackupEnabled()) {
      void clearRecording()
        .catch(() => {})
        .then(() => audioRecorder.start());
    }
    void acquireWakeLock();
    startTimers();
  }

  async function finish() {
    recording = false;
    recognizer.stop();
    audioRecorder.stop();
    stopTimers();
    setBadge('stopped', '');
    els.stop.hidden = true;
    els.start.hidden = false;
    els.course.disabled = false;
    els.topic.disabled = false;
    els.category.disabled = false;
    els.transcriptInterim.textContent = '';
    try {
      wakeLock?.release();
    } catch {
      // released already
    }
    await aiTick(true);
    els.actionsCard.hidden = false;
    els.save.disabled = !localStorage.getItem('live.githubToken');
    els.saveStatus.textContent = els.save.disabled
      ? 'add a GitHub token in settings to save, or download'
      : '';
    await offerRecording();
  }

  /** Show the audio actions only when there is actually audio to offer. */
  async function offerRecording() {
    let bytes = 0;
    try {
      bytes = await recordedBytes();
    } catch {
      // No IndexedDB (private mode, blocked storage): nothing to offer.
    }
    const has = bytes > 0;
    els.downloadAudio.hidden = !has;
    els.audioHint.hidden = !has;
    if (has) els.downloadAudioLabel.textContent = `Download recording (${formatBytes(bytes)})`;
  }

  els.start.addEventListener('click', async () => {
    // The store holds one recording, so starting a new lecture drops the old
    // audio. Only ask when there is genuinely something to lose.
    let pending = 0;
    try {
      pending = await recordedBytes();
    } catch {
      // No IndexedDB: nothing to lose.
    }
    if (
      pending > 0 &&
      !confirm(
        `Starting a new recording deletes the previous audio (${formatBytes(pending)}). ` +
          'Download it first if you still need it. Start anyway?',
      )
    ) {
      return;
    }
    begin();
  });
  els.stop.addEventListener('click', () => void finish());

  // ---------- finish actions ----------
  els.save.addEventListener('click', async () => {
    if (!session) return;
    const token = localStorage.getItem('live.githubToken');
    if (!token) return;
    els.save.disabled = true;
    els.saveStatus.textContent = 'saving...';
    els.saveError.hidden = true;
    try {
      const result = await saveToRepo({ token, session, date: new Date() });
      els.saveSiteLink.href = result.siteUrl;
      els.saveRepoLink.href = result.url;
      els.saveSuccess.hidden = false;
      els.saveStatus.textContent = '';
      clearSession();
      session = null;
    } catch (err) {
      els.save.disabled = false;
      els.saveStatus.textContent = '';
      els.saveError.hidden = false;
      els.saveError.textContent = `Save failed: ${err instanceof Error ? err.message : String(err)}. Nothing is lost, use Download.`;
    }
  });

  els.download.addEventListener('click', () => {
    if (session) downloadMd(session, new Date());
  });

  els.downloadAudio.addEventListener('click', async () => {
    els.downloadAudio.disabled = true;
    try {
      const blob = await readRecording(audioRecorder.mimeType());
      if (!blob) {
        els.saveStatus.textContent = 'no recording found';
        return;
      }
      // Name it after the note it belongs to, so the pair is obvious later.
      const prefix = session?.courseId || session?.category || '';
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = audioFilename(prefix, new Date(), blob.type);
      a.click();
      URL.revokeObjectURL(url);
    } catch (err) {
      els.saveStatus.textContent = `could not read the recording: ${
        err instanceof Error ? err.message : String(err)
      }`;
    } finally {
      els.downloadAudio.disabled = false;
    }
  });

  els.copy.addEventListener('click', async () => {
    if (!session) return;
    await navigator.clipboard.writeText(session.notes || transcriptText(session));
    els.saveStatus.textContent = 'copied';
  });

  els.discard.addEventListener('click', () => {
    if (!session) return;
    if (!confirm('Discard this session? The transcript, notes and recording will be gone.')) return;
    clearSession();
    void clearRecording().catch(() => {});
    session = null;
    els.actionsCard.hidden = true;
    els.downloadAudio.hidden = true;
    els.audioHint.hidden = true;
    els.audioStatus.textContent = '';
    els.transcriptFinal.textContent = '';
    els.notes.innerHTML = '';
    els.transcriptEmpty.hidden = false;
    els.timer.textContent = '00:00';
    els.wordcount.textContent = '0 words';
    setBadge('idle', '');
  });

  // ---------- restore ----------
  const saved = loadSession();
  if (saved) {
    els.restoreBanner.hidden = false;
    els.restoreInfo.textContent = `${saved.courseCode}, ${new Date(saved.startedAt).toLocaleString()}`;
    els.restoreOpen.addEventListener('click', () => {
      session = saved;
      for (const opt of Array.from(els.course.options)) {
        if (opt.value === saved.courseId) opt.selected = true;
      }
      els.topic.value = saved.topic;
      els.restoreBanner.hidden = true;
      renderTranscript();
      void renderNotes();
      void finish();
    });
    els.restoreDiscard.addEventListener('click', () => {
      clearSession();
      void clearRecording().catch(() => {});
      els.restoreBanner.hidden = true;
    });
  }

  // ---------- guards + support ----------
  if (!isSupported()) {
    els.unsupported.hidden = false;
    els.start.disabled = true;
  }
  window.addEventListener('beforeunload', (e) => {
    if (recording) {
      e.preventDefault();
      e.returnValue = '';
    }
  });

  // Debug hook: lets a micless environment exercise the whole pipeline.
  (window as any).__live = {
    injectFinal(text: string) {
      if (!session) return;
      session.finals.push(text);
      persistSession(session);
      renderTranscript();
    },
    tick: () => aiTick(false),
    state: () => ({ recording, session }),
    // Exercises the audio store without a microphone: append, read back, clear.
    audio: { appendChunk, readRecording, recordedBytes, clearRecording, offerRecording },
  };
</script>
