    background: var(--good-tint);
    color: var(--good);
    border-color: var(--good-tint-border);
  }
  .panes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 16px;
  }
  @media (max-width: 900px) {
    .panes {
      grid-template-columns: 1fr;
    }
  }
  .pane-body {
    margin-top: 14px;
    max-height: 420px;
    overflow-y: auto;
    font-size: 14px;
    line-height: 1.65;
  }
  .interim {
    color: var(--text-muted);
  }
  .actions-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
    margin: 14px 0 0;
  }
  .card-lite {
    margin-top: 14px;
    padding: 13px 16px;
    border-radius: var(--radius-md);
    font-size: 13.5px;
    border: 1px solid transparent;
  }
  .alert-success.card-lite {
    background: var(--good-tint);
    color: var(--good);
    border-color: var(--good-tint-border);
  }
