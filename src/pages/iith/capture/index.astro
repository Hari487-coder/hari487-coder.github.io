    color: inherit;
    font-weight: 600;
    text-decoration: underline;
  }
  .alert-error.card-lite {
    background: var(--critical-tint);
    color: var(--critical);
    border-color: var(--critical-tint-border);
  }
  .alert-warn {
    font-size: 13.5px;
    color: var(--warning);
    background: var(--warning-tint);
    border-color: var(--warning-tint-border);
    margin-bottom: 16px;
  }
  .alert-info {
    font-size: 13.5px;
    color: var(--accent-strong);
    background: var(--accent-tint);
    border-color: var(--accent-tint-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  .restore-actions {
    display: flex;
    gap: 8px;
  }
  .settings {
    margin-top: 16px;
  }
  .settings summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 14.5px;
    display: flex;
    align-items: center;
    gap: 8px;
    list-style: none;
