---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '../../../layouts/Base.astro';
import SubTabs from '../../../components/SubTabs.astro';
import { NOTE_TABS } from '../../../lib/subnav';
import { fmt } from '../../../lib/dates';
import { CATEGORY_LIST } from '../../../lib/categories';

const courses = (await getCollection('courses')).sort((a, b) => {
  const rank = (s: string) => (s === 'ongoing' ? 0 : 1);
  return rank(a.data.status) - rank(b.data.status) || a.data.code.localeCompare(b.data.code);
});

const courseOptions = courses.map((c) => ({
  id: c.id,
  code: c.data.code,
  name: c.data.name,
}));

const allNotes = (await getCollection('notes')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

/** Past coursework notes per course, so the recorder can show what came before. */
const notesByCourse: Record<string, { title: string; href: string; date: string }[]> = {};
for (const n of allNotes) {
  if (!n.data.course) continue;
  (notesByCourse[n.data.course.id] ??= []).push({
    title: n.data.title,
    href: `/notes/${n.id}/`,
    date: fmt(n.data.date),
  });
}
---

<Base
  title="Capture: record live"
  description="Live lecture recorder: the browser transcribes, Claude takes structured notes, one click saves them to the site."
>
  <div class="page-head">
    <div class="page-head-text">
      <p class="eyebrow">Capture</p>
      <h1>Record live</h1>
      <p class="subtitle">
        Pick the course, hit start, put the laptop near the front. The browser transcribes
        the lecture and Claude grows structured notes as the professor speaks.
      </p>
    </div>
  </div>

  <SubTabs tabs={NOTE_TABS} active="record" />

  <div class="alert-info card" id="unsupported" hidden>
    This browser has no speech recognition. Open this page in Chrome on your laptop or
    Android phone.
  </div>

  <div class="alert-info card" id="restore-banner" hidden>
    <span>There is an unsaved session from <strong id="restore-info"></strong>.</span>
    <span class="restore-actions">
      <button class="btn-secondary" id="restore-open">Open it</button>
      <button class="btn-secondary" id="restore-discard">Discard</button>
    </span>
  </div>

  <div class="alert-warn card" id="no-token-warning" hidden>
    <span>
      <strong>Nothing you record here is saved until you press Save to site</strong>, and
      saving needs a GitHub token. Add one in Keys below before you start, or you will
      finish the lecture with no way to keep it except Download.
    </span>
  </div>

  <div class="card">
    <div class="controls">
      <label class="field">
        <span class="field-label">Section</span>
        <select id="category">
          {CATEGORY_LIST.map((c) => (
            <option value={c.id} selected={c.id === 'iith'}>{c.label}</option>
          ))}
        </select>
      </label>
      <label class="field" id="course-field">
        <span class="field-label">Course</span>
        <select id="course">
          {courseOptions.map((c) => (
            <option value={c.id} data-code={c.code} data-name={c.name}>
              {c.code} · {c.name}
            </option>
          ))}
        </select>
      </label>
      <label class="field">
        <span class="field-label">Topic (optional)</span>
        <input id="topic" type="text" placeholder="e.g. cash flow statements" />
      </label>
      <div class="run-controls">
        <button class="btn" id="start">
          <Icon name="lucide:mic" /> Start
        </button>
        <button class="btn" id="stop" hidden>
          <Icon name="lucide:square" /> Stop
        </button>
        <span class="badge" id="status-badge"><span class="dot" aria-hidden="true"></span><span id="status-text">idle</span></span>
        <span class="mono meta" id="timer">00:00</span>
        <span class="mono meta" id="wordcount">0 words</span>
        <span class="mono meta" id="audio-status"></span>
      </div>
    </div>
  </div>

  <div class="panes">
    <div class="card pane">
      <div class="card-row">
        <h2>Transcript</h2>
        <span class="meta">raw, live</span>
      </div>
      <div class="pane-body" id="transcript">
        <p class="meta" id="transcript-empty">Waiting to start.</p>
        <span id="transcript-final"></span>
        <span id="transcript-interim" class="interim"></span>
      </div>
    </div>
    <div class="card pane">
      <div class="card-row">
        <h2>Notes</h2>
        <span class="meta" id="notes-status">AI idle</span>
      </div>
      <div class="pane-body prose" id="notes">
        <p class="meta" id="notes-empty">
          Notes appear here a couple of minutes into the lecture.
        </p>
      </div>
    </div>
  </div>

  <section class="section" id="past-notes-section">
    <div class="section-head">
      <h2>Notes for this course</h2>
      <a class="section-link" href="/notes/">All notes <Icon name="lucide:arrow-right" /></a>
      <span class="meta" id="past-count"></span>
    </div>
    <div class="card">
      <p class="meta" id="past-empty">No notes saved for this course yet.</p>
      <ul class="row-list" id="past-list" style="margin-top: 0;" hidden></ul>
    </div>
  </section>

  <div class="card" id="actions-card" hidden>
    <div class="card-row">
      <h2>Finish</h2>
      <span class="meta" id="save-status"></span>
    </div>
    <p class="actions-row">
      <button class="btn" id="save"><Icon name="lucide:upload" /> Save to site</button>
      <button class="btn-secondary" id="download"><Icon name="lucide:download" /> Download .md</button>
      <button class="btn-secondary" id="download-audio" hidden>
        <Icon name="lucide:file-audio" /> <span id="download-audio-label">Download recording</span>
      </button>
      <button class="btn-secondary" id="copy"><Icon name="lucide:copy" /> Copy notes</button>
      <button class="btn-secondary" id="discard"><Icon name="lucide:trash-2" /> Discard</button>
    </p>
    {/* The live transcript is the rough index; the audio is the good record. */}
    <p class="meta" id="audio-hint" hidden>
      Chrome's live transcript is rough on lecture audio. For a clean one, download the
      recording and run it through <a href="/iith/capture/import/">import</a>, which
      transcribes locally with Whisper.
    </p>
    <div class="alert-success card-lite" id="save-success" hidden>
      Saved. The site is rebuilding; the notes will be live in about two minutes at
      <a id="save-site-link" href="/">this page</a> (<a id="save-repo-link" href="/">commit</a>).
    </div>
    <div class="alert-error card-lite" id="save-error" hidden></div>
  </div>

  <details class="card settings">
    <summary>
      <Icon name="lucide:settings-2" /> Keys and privacy
    </summary>
    <div class="settings-body">
      <label class="field">
        <span class="field-label">Anthropic API key (for live AI notes)</span>
        <input id="key-anthropic" type="password" autocomplete="off" placeholder="sk-ant-..." />
      </label>
      <label class="field">
        <span class="field-label">GitHub token (fine-grained, this repo only, contents read-write)</span>
        <input id="key-github" type="password" autocomplete="off" placeholder="github_pat_..." />
      </label>
      <p class="actions-row">
        <button class="btn-secondary" id="save-keys">Save keys</button>
        <button class="btn-secondary" id="test-key">
          <Icon name="lucide:plug-zap" /> Test key
        </button>
        <span class="meta" id="keys-status"></span>
      </p>
      {/* Off by default: opening a second microphone stream can knock out
          Chrome's own speech capture, and losing the transcript is worse than
          losing the audio backup. */}
      <label class="check-field">
        <input id="opt-record-audio" type="checkbox" />
        <span>
          <strong>Also record the audio</strong>
          <span class="meta" style="display:block">
            A backup you can run through <a href="/iith/capture/import/">import</a> for a
            far better transcript. Off by default because on some machines a second
            microphone stream stops Chrome's live transcription. Turn it on, do a short
            test, and check words still appear before relying on it in class.
          </span>
        </span>
      </label>
      <p class="meta">
        Keys are stored only in this browser and sent only to api.anthropic.com and
        api.github.com. Chrome speech recognition sends lecture audio to Google. Get the
        professor's permission before recording, and remember saved notes are public on
        this site. Without an Anthropic key, this page still works as a free live
        transcriber.
      </p>
    </div>
  </details>
</Base>

<style>
  .controls {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .field {
    display: block;
  }
  .field-label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-bottom: 8px;
    color: var(--text-secondary);
  }
  .field select,
  .field input {
    width: 100%;
    padding: 11px 14px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    font-size: 14.5px;
    background: var(--surface);
    color: var(--text-primary);
    font-family: inherit;
  }
  .field select:focus,
  .field input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--ring);
  }
  .run-controls {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .badge.rec {
    background: var(--critical-tint);
    color: var(--critical);
    border-color: var(--critical-tint-border);
  }
