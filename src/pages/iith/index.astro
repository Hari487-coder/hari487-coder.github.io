---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SubTabs from '../../components/SubTabs.astro';
import { COURSE_TABS } from '../../lib/subnav';
import StatusBadge from '../../components/StatusBadge.astro';
import { credits as fmtCredits } from '../../lib/format';

const courses = await getCollection('courses');

const semesters = [...new Set(courses.map((c) => c.data.semester))].sort((a, b) => a - b);
const bySemester = semesters.map((s) => {
  const list = courses
    .filter((c) => c.data.semester === s)
    .sort((a, b) => a.data.code.localeCompare(b.data.code));
  return { semester: s, list, total: list.reduce((sum, c) => sum + c.data.credits, 0) };
});

const COURSE_BADGE = {
  ongoing: { tone: 'good', label: 'In session' },
  done: { tone: 'neutral', label: 'Completed' },
  planned: { tone: 'accent', label: 'Planned' },
} as const;
---

<Base title="Courses" description="IITH coursework: every course in the M.Tech, semester by semester.">
  <div class="page-head">
    <div class="page-head-text">
      <p class="eyebrow">IIT Hyderabad</p>
      <h1>Courses</h1>
      <p class="subtitle">M.Tech Techno-Entrepreneurship, July 2026 onward.</p>
    </div>
  </div>

  <SubTabs tabs={COURSE_TABS} active="courses" />

  {bySemester.map(({ semester, list, total }) => (
    <section class="section">
      <div class="section-head">
        <h2>Semester {semester}</h2>
        <span class="meta">{fmtCredits(total)}</span>
      </div>
      <div class="card flush">
        <ul class="row-list" style="margin-top: 0;">
          {list.map((c) => (
            <li>
              <div class="row-main">
                <a class="row-title" href={`/iith/courses/${c.id}/`}>{c.data.name}</a>
                <div class="row-sub">
                  {c.data.code}{c.data.slot ? ` · Slot ${c.data.slot}` : ''} · {fmtCredits(c.data.credits)}
                  {c.data.instructor ? ` · ${c.data.instructor}` : ''}
                </div>
              </div>
              <div class="row-side">
                <StatusBadge tone={COURSE_BADGE[c.data.status].tone} label={COURSE_BADGE[c.data.status].label} />
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}
</Base>
