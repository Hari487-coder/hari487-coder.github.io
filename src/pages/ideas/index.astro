---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { fmt } from '../../lib/dates';

const ideas = (await getCollection('ideas')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const groups = [
  {
    kind: 'application' as const,
    title: 'Applied to what I build',
    empty: 'Nothing yet. Start one from the IITH brainstorm.',
    href: '/iith/brainstorm/',
    cta: 'Open brainstorm',
  },
  {
    kind: 'content' as const,
    title: 'Content',
    empty: 'Nothing yet. Start one in the studio.',
    href: '/studio/',
    cta: 'Open studio',
  },
];
---

<Base title="Ideas" description="Applications of coursework to real projects, and content ideas.">
  <div class="page-head">
    <div class="page-head-text">
      <p class="eyebrow">{ideas.length} saved</p>
      <h1>Ideas</h1>
      <p class="subtitle">
        What came out of thinking over your own material: coursework applied to real
        products, and content worth making.
      </p>
    </div>
  </div>

  {groups.map((group) => {
    const list = ideas.filter((i) => i.data.kind === group.kind);
    return (
      <section class="section">
        <div class="section-head">
          <h2>{group.title}</h2>
          <span class="meta">{list.length}</span>
        </div>
        {list.length === 0 ? (
          <p class="section-empty">
            {group.empty} <a href={group.href}>{group.cta}</a>
          </p>
        ) : (
          <div class="card flush">
            <ul class="row-list" style="margin-top: 0;">
              {list.map((idea) => (
                <li>
                  <div class="row-main">
                    <a class="row-title" href={`/ideas/${idea.id}/`}>{idea.data.title}</a>
                  </div>
                  <div class="row-side">
                    <span class="row-due">{fmt(idea.data.date)}</span>
                    <StatusBadge
                      tone={group.kind === 'application' ? 'accent' : 'good'}
                      label={group.kind === 'application' ? 'applied' : 'content'}
                    />
                  </div>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>
    );
  })}
</Base>
