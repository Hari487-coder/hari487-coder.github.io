---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import SubTabs from '../../components/SubTabs.astro';
import { NOTE_TABS } from '../../lib/subnav';
import { fmt } from '../../lib/dates';
import { CATEGORY_LIST } from '../../lib/categories';

const courses = await getCollection('courses');
const courseById = new Map(courses.map((c) => [c.id, c]));

const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const sections = CATEGORY_LIST.map((meta) => ({
  meta,
  items: notes.filter((n) => n.data.category === meta.id),
}));
---

<Base title="Notes" description="Every note captured: projects, work, coursework, and content.">
  <div class="page-head">
    <div class="page-head-text">
      <p class="eyebrow">{notes.length} saved</p>
      <h1>Notes</h1>
      <p class="subtitle">
        Everything you have captured, split by where it belongs. Add more from
        <a href="/iith/capture/">Capture</a>.
      </p>
    </div>
    <a class="btn-secondary" href="/iith/brainstorm/">
      <Icon name="lucide:brain" /> Brainstorm from notes
    </a>
  </div>

  <SubTabs tabs={NOTE_TABS} active="notes" />

  {notes.length === 0 && (
    <div class="card">
      <div class="empty-state">
        <span class="empty-icon"><Icon name="lucide:notebook-pen" /></span>
        <p>
          No notes saved yet. Notes only reach this page when you press <strong>Save to
          site</strong>, which needs a GitHub token in the recorder settings. Anything
          still sitting in a recorder tab can be recovered from its restore banner.
        </p>
        <a class="btn" href="/iith/capture/">Open the recorder</a>
      </div>
    </div>
  )}

  {/* With nothing saved at all, the composed empty state above says it once;
      repeating "nothing here yet" per section adds three more things to read. */}
  {notes.length > 0 && sections.map(({ meta, items }) => (
    <section class="section">
      <div class="section-head">
        <h2>{meta.label}</h2>
        <span class="meta">{items.length}</span>
      </div>
      {/* An empty section gets a line of text, not an empty box to look at. */}
      {items.length === 0 ? (
        <p class="section-empty">{meta.blurb} Nothing here yet.</p>
      ) : (
        <div class="card flush">
          <ul class="row-list" style="margin-top: 0;">
            {items.map((note) => {
              const course = note.data.course ? courseById.get(note.data.course.id) : undefined;
              return (
                <li>
                  <div class="row-main">
                    <a class="row-title" href={`/notes/${note.id}/`}>{note.data.title}</a>
                    {course && <div class="row-sub">{course.data.code} · {course.data.name}</div>}
                  </div>
                  <div class="row-side">
                    <span class="row-due">{fmt(note.data.date)}</span>
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      )}
    </section>
  ))}
</Base>
